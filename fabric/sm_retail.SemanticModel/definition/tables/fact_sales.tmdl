table fact_sales
	lineageTag: 01b7b3f0-a7f4-4e88-a925-caa3c7be7fa1
	sourceLineageTag: [dbo].[fact_sales]

	measure 'Total Sales' = SUM(fact_sales[line_amount])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: e80a8999-2976-46b1-8b59-517801bb9830

	measure Orders = DISTINCTCOUNT(fact_sales[order_id])
		formatString: #,0
		lineageTag: ee211da9-e863-4a12-930b-9bc6555fe8df

	measure Units = SUM(fact_sales[quantity])
		formatString: #,0
		lineageTag: a9e67067-d4ec-4bba-b0ba-82ff81351f47

	measure 'Avg Order Value' = DIVIDE([Total Sales], [Orders])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: ac34fba1-6609-41d5-8a89-8e388d61401f

