model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["DirectLake - lh_gold"]

annotation PBI_ProTooling = ["DirectLakeOnOneLakeInWeb","WebModelingEdit","TMDLView_Desktop"]

ref table dim_customer
ref table dim_date
ref table dim_stock_item
ref table dim_store
ref table fact_promotion
ref table fact_sales
ref table fact_stock_holding
ref table fact_store_footfall
ref table dq_result
ref table run_log
ref table fact_pos_daily

