  "queries": [
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "fb5bc8bc-4794-43f5-a6f1-1a92f1de8796"
      },
      "text": "['events_raw'] | take 10",
      "id": "28d5b2d5-5b90-4955-a64d-1f1d676cc3cf",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "fb5bc8bc-4794-43f5-a6f1-1a92f1de8796"
      },
      "text": "mv_pos_sales_1m\r\n| where window_start > ago(1h)\r\n| project window_start, store_id = tostring(store_id), revenue",
      "id": "f64647c5-257f-4e72-a256-2779a79a3180",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "fb5bc8bc-4794-43f5-a6f1-1a92f1de8796"
      },
      "text": "mv_pos_item_velocity_15m\r\n| where window_start > ago(15m)\r\n| summarize units = sum(units) by stock_item_id\r\n| top 10 by units",
      "id": "3fa6f6e3-2698-457a-b4d3-b4408a1aeb12",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "fb5bc8bc-4794-43f5-a6f1-1a92f1de8796"
      },
      "text": "mv_iot_device_1m\r\n| where sensor_type == \"freezer\" and window_start > ago(1h)\r\n| summarize temp_c = avg(avg_value) by window_start, store_id = tostring(store_id)",
      "id": "76c0fa10-ca1b-4f46-94f5-5316bcbe6d1c",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "fb5bc8bc-4794-43f5-a6f1-1a92f1de8796"
      },
      "text": "mv_click_funnel_5m\r\n| where window_start > ago(1h)\r\n| summarize events = sum(events) by action\r\n| order by events desc",
      "id": "fe361281-8fb8-422a-9440-a5bd69b1af88",
      "usedVariables": []
    },
    {
      "dataSource": {
        "kind": "inline",
        "dataSourceId": "fb5bc8bc-4794-43f5-a6f1-1a92f1de8796"
      },
      "text": "pos_transactions\r\n| where event_time > ago(5m)\r\n| summarize revenue = round(sum(amount), 2)",
      "id": "c50be761-e46e-4442-9bcb-9f7c53ea2931",
      "usedVariables": []
    }
  ],
