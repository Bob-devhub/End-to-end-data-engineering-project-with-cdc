.create-merge table events_raw (event:dynamic, event_type:string, device_id:string, store_id:string, sensor_type:string, value:real, unit:string, event_time:datetime, session_id:guid, customer_id:string, page:string, action:string, stock_item_id:string, transaction_id:guid, register_id:string, quantity:int, unit_price:real, amount:real, payment_method:string) 
.create-or-alter table events_raw ingestion json mapping 'events_raw_mapping'
