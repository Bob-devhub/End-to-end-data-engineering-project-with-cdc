# Copy to .env for local runs. Never commit real values.

# Control/metadata database (SQL database in Fabric) - from its "Connection strings" page
CONTROL_DB_SERVER=xxxxxxxx.database.fabric.microsoft.com
CONTROL_DB_NAME=sqldb_control-xxxxxxxx

# Eventhouse / KQL database
KUSTO_CLUSTER_URI=https://xxxxxxxx.kusto.fabric.microsoft.com
KUSTO_DATABASE=kql_retail_rt

# Eventstream custom endpoint (Event Hub-compatible connection string, includes EntityPath)
EVENTSTREAM_CONNECTION_STRING=

# Fabric workspace IDs per environment (used by deploy/deploy.py)
FABRIC_WORKSPACE_ID_DEV=
FABRIC_WORKSPACE_ID_TEST=
FABRIC_WORKSPACE_ID_PROD=
